# Copy to .env (never commit it) and fill in. Anything not listed keeps the server's default.
# Full list of settings: ../docs/operations.md

# ---- required ----
# Generate with:  openssl rand -hex 24      (letters and numbers only, so the database address stays valid)
POSTGRES_PASSWORD=
# Staff API secret, 32+ characters:  openssl rand -hex 32
ADMIN_TOKEN=
# The address invite links point at
PUBLIC_BASE_URL=https://cornhole.example.com

# ---- this box ----
# The game listens on 127.0.0.1:APP_PORT. Pick a free port (other iPlay games use their own).
APP_PORT=3010
# Only for the bundled proxy (docker compose --profile proxy up -d)
DOMAIN=cornhole.example.com
# Image tag; change when you want to keep old versions around for a quick rollback
TAG=latest

# ---- accounts ----
# Empty = that sign-in is off. Guests work unless ALLOW_GUESTS=false.
# Apple: the app's bundle id (com.iplay.cornhole). Google: the "Web application" OAuth client id from the Google Cloud
# console (the same value as googleWebClientId in the app's Resources/iplay-cornhole-server.json).
APPLE_CLIENT_IDS=
GOOGLE_CLIENT_IDS=
ALLOW_GUESTS=true
# Every iPlay game is for adults: new accounts must confirm they are 18+. Bump TERMS_VERSION when the terms change.
REQUIRE_ADULT_CONFIRMATION=true
TERMS_VERSION=1

# ---- app versions ----
MIN_CLIENT_VERSION=0.0.0
# LATEST_CLIENT_VERSION=1.0.0
# IOS_STORE_URL=
# ANDROID_STORE_URL=
DEEP_LINK_SCHEME=iplaycornhole
# Invite links open straight in the app (the server publishes the files iPhones and Androids check):
# APPLE_TEAM_ID=ABCDE12345
# IOS_BUNDLE_ID=com.iplay.cornhole
# ANDROID_PACKAGE=com.iplay.cornhole
# ANDROID_CERT_SHA256=AA:BB:...   (Play Console > App integrity > App signing key certificate, SHA-256)

# ---- voice chat (Unity Vivox). Set all four, or none to keep voice off. ----
# If your other iPlay games already use Vivox, reuse the same values.
VIVOX_ISSUER=
VIVOX_DOMAIN=
VIVOX_SIGNING_KEY=
VIVOX_UNITY_ENVIRONMENT_ID=

# ---- ads (the only income; nothing is for sale) ----
ADS_ENABLED=false
ADS_INTERSTITIAL_EVERY_N_MATCHES=3
ADS_MIN_SECONDS_BETWEEN_INTERSTITIALS=180
ADS_MENU_BANNER=true

# ---- public pages and data ----
# Shown on /support and /delete-account. The server also hosts /privacy and /terms from docs/legal.
SUPPORT_EMAIL=
# Delete match history older than this many days (0 = keep forever). Ratings are kept either way.
MATCH_HISTORY_DAYS=0

# ---- limits ----
RATE_LIMIT_PER_MIN=300
MAX_MATCHES=2000
LOG_LEVEL=info
