{
  "name": "iplay-cornhole-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run test",
    "sfx": "tsx tools/generate-sfx.ts",
    "logo": "tsx tools/extract-logo.ts",
    "board": "tsx tools/export-board.ts",
    "assets": "npm run sfx && npm run logo && npm run board",
    "preview": "tsx tools/build-preview.ts",
    "loadtest": "tsx tools/loadtest.ts"
  },
  "dependencies": {
    "@fastify/rate-limit": "^10.0.0",
    "@fastify/websocket": "^11.0.0",
    "fastify": "^5.0.0",
    "obscenity": "^0.4.6",
    "pg": "^8.23.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "@types/pngjs": "^6.0.5",
    "@types/ws": "^8.5.0",
    "jpeg-js": "^0.4.4",
    "pngjs": "^7.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.2",
    "ws": "^8.22.0"
  }
}
