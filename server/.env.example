# Copy to .env for local development. In production set these in your host's settings instead.
# Everything is optional except DATABASE_URL in production.

NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# Production: a real Postgres. Local dev: pglite://./.data (a database in a folder, nothing to install)
# or leave empty for a throwaway in-memory one.
DATABASE_URL=pglite://./.data
DATABASE_SSL=false

# The address invite links point at
PUBLIC_BASE_URL=http://localhost:3000

# Apps older than this are told to update (0.0.0 = check off)
MIN_CLIENT_VERSION=0.0.0
# LATEST_CLIENT_VERSION=1.0.0
# IOS_STORE_URL=https://apps.apple.com/app/id0000000000
# ANDROID_STORE_URL=https://play.google.com/store/apps/details?id=com.iplay.cornhole

# Sign in. Empty = that method is off. Guests always work unless ALLOW_GUESTS=false.
# APPLE_CLIENT_IDS=com.iplay.cornhole
# GOOGLE_CLIENT_IDS=1234567890-abc.apps.googleusercontent.com
ALLOW_GUESTS=true

# Staff API secret, 32+ characters. Empty = the admin API does not exist.
# ADMIN_TOKEN=

# Universal links / app links (once the apps exist)
# APPLE_TEAM_ID=
# IOS_BUNDLE_ID=com.iplay.cornhole
# ANDROID_PACKAGE=com.iplay.cornhole
# ANDROID_CERT_SHA256=AA:BB:...
DEEP_LINK_SCHEME=iplaycornhole

# Behind a load balancer? Set true so rate limits see real client addresses.
TRUST_PROXY=false
RATE_LIMIT_PER_MIN=300
MAX_MATCHES=5000
MAINTENANCE=false
OWNERSHIP_WAIT_SEC=90
RESTORE_MAX_AGE_MIN=120

# Every iPlay game is for adults: new accounts confirm they are 18+. Bump TERMS_VERSION when the terms change.
REQUIRE_ADULT_CONFIRMATION=true
TERMS_VERSION=1

# Voice chat (Unity Vivox). Set all four or none. (IPLAY_VIVOX_* names from the other iPlay games also work.)
# VIVOX_ISSUER=
# VIVOX_DOMAIN=
# VIVOX_SIGNING_KEY=
# VIVOX_UNITY_ENVIRONMENT_ID=

# Ads are the only income. These are the pacing rules the app is told to follow.
ADS_ENABLED=false
ADS_INTERSTITIAL_EVERY_N_MATCHES=3
ADS_MIN_SECONDS_BETWEEN_INTERSTITIALS=180
ADS_MENU_BANNER=true
